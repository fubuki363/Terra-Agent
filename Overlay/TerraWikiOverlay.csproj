<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TerraWikiOverlay</AssemblyName>
    <RootNamespace>TerraWikiOverlay</RootNamespace>
    <Version>1.5.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OverlayTransitions" />
    <EmbeddedResource Include="Harness\**\*" LogicalName="Harness/%(Filename)%(Extension)" />
    <Content Include="Harness\vendor\*.LICENSE*" CopyToPublishDirectory="PreserveNewest" Link="licenses\%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Services\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\Services\ClientIdentity.cs" Link="Shared\ClientIdentity.cs" />
    <Compile Include="..\Services\AgentTools.cs" Link="Shared\AgentTools.cs" />
    <Compile Include="..\Services\ApiKeyProvider.cs" Link="Shared\ApiKeyProvider.cs" />
    <Compile Include="..\Services\WikiCache.cs" Link="Shared\WikiCache.cs" />
    <Compile Include="..\Services\TerrariaWikiClient.cs" Link="Shared\TerrariaWikiClient.cs" />
    <Compile Include="..\Services\CommunitySearchClient.cs" Link="Shared\CommunitySearchClient.cs" />
    <Compile Include="..\Services\DeepSeekClient.cs" Link="Shared\DeepSeekClient.cs" />
    <Compile Include="..\Services\WikiResearchService.cs" Link="Shared\WikiResearchService.cs" />
    <Compile Include="..\Services\ConversationStore.cs" Link="Shared\ConversationStore.cs" />
    <Compile Include="..\Services\UsageTracker.cs" Link="Shared\UsageTracker.cs" />
  </ItemGroup>
  <Target Name="PackageGameReader" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <GameReaderPublish>$(MSBuildThisFileDirectory)obj\game-reader\publish\</GameReaderPublish>
      <GameReaderZip>$(MSBuildThisFileDirectory)obj\game-reader\payload.zip</GameReaderZip>
    </PropertyGroup>
    <MSBuild Projects="..\GameReader\TerraAgent.GameReader.csproj" Targets="Restore;Publish"
      RemoveProperties="OutputPath;OutDir;BaseIntermediateOutputPath;IntermediateOutputPath"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;PlatformTarget=x64;SelfContained=false;PublishSingleFile=false;UseAppHost=false;PublishDir=$(GameReaderPublish)" />
    <ZipDirectory SourceDirectory="$(GameReaderPublish)" DestinationFile="$(GameReaderZip)" Overwrite="true" />
    <ItemGroup><EmbeddedResource Include="$(GameReaderZip)" LogicalName="TerraAgent.GameReader.zip" /></ItemGroup>
  </Target>
</Project>
